{
  "name": "dashboard",
  "version": "1.0.0",
  "description": "Urumi MCP Gateway Admin Dashboard",
  "main": "dist/index.js",
  "scripts": {
    "build:server": "esbuild src/index.ts --bundle --platform=node --target=node20 --outfile=dist/index.js --packages=external",
    "build:client": "esbuild src/client/index.tsx --bundle --minify --outfile=dist/public/app.js --define:process.env.NODE_ENV=\"\\\"production\\\"\"",
    "build": "npm run build:server && node copy-public.js && npm run build:client",
    "copy-assets": "node copy-public.js",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.19",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/supertest": "^6.0.2",
    "esbuild": "^0.28.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
